# Build output -- regenerated by build_exe.bat, never committed
build/
dist/
dist-test/
build-test/
dist-release/
dist-test*/
build-release/
build-test*/
Output/
*.spec
*.log

# Bundled binary, fetched at build time (~100 MB, GPL v3 -- see NOTICE.md).
# build_exe.bat downloads this automatically if it's missing.
vendor/

# Generated from app/config.py by build_version_info.py
version_info.txt

# Virtual environment (created by build_exe.bat)
.venv312/
.venv/
venv/

# Python
__pycache__/
*.py[cod]
*.egg-info/

# Local editor / tooling state
.claude/
.vscode/
.idea/

# OS
Thumbs.db
desktop.ini
.DS_Store

# Local shortcut, machine-specific paths
*.lnk

# Showcase video project: dependencies, caches and rendered output
video/node_modules/
video/out/
video/npm-install.log
video/*.mp4

# Never commit a release signing key (tools/release_sign.py keeps it outside the repo)
*.key
release-signing*

# Showcase video: generated soundtrack and app captures (npm run audio / npm run capture)
video/public/audio/
video/public/captures/
video/poster.png
